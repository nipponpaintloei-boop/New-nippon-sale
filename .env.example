# Google OAuth Client ID for the web app.
# Required for writing sales data to the user-selected Google Sheet.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: only needed if you want to use the Google Drive Picker UI.
# The app can connect to an existing Sheet by pasting its URL, so these are not required for normal use.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
